diff --git a/src/core/experimental_trace.h b/src/core/experimental_trace.h
new file mode 100644
--- /dev/null
+++ b/src/core/experimental_trace.h
@@ -0,0 +1,70 @@
+#ifndef SD_EXPERIMENTAL_TRACE_H
+#define SD_EXPERIMENTAL_TRACE_H
+#include <algorithm>
+#include <cmath>
+#include <cstdarg>
+#include <cstddef>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <mutex>
+
+namespace sd::experimental_trace {
+inline bool enabled() { return std::getenv("LOCAL_DREAM_DIT_PROFILE") != nullptr; }
+inline std::mutex& mutex() { static std::mutex value; return value; }
+inline void emit(const char* format, ...) {
+    if (!enabled()) return;
+    char message[2048];
+    va_list args; va_start(args, format); std::vsnprintf(message, sizeof(message), format, args); va_end(args);
+    std::lock_guard<std::mutex> guard(mutex());
+    std::fprintf(stderr, "FP8_TRACE %s\n", message); std::fflush(stderr);
+    const char* path = std::getenv("LOCAL_DREAM_DIAGNOSTIC_PATH");
+    if (path && path[0]) {
+        if (FILE* file = std::fopen(path, "a")) {
+            std::fprintf(file, "FP8_TRACE %s\n", message); std::fclose(file);
+        }
+    }
+}
+inline void reset() {
+    if (!enabled()) return;
+    std::lock_guard<std::mutex> guard(mutex());
+    const char* path = std::getenv("LOCAL_DREAM_DIAGNOSTIC_PATH");
+    if (path && path[0]) if (FILE* file = std::fopen(path, "w")) std::fclose(file);
+}
+struct Stats {
+    size_t finite=0, nan=0, inf=0, zero=0, below_zero=0, above_one=0;
+    float lo=std::numeric_limits<float>::infinity(), hi=-std::numeric_limits<float>::infinity();
+    double sum=0, square_sum=0;
+    void add(float x) {
+        if (std::isnan(x)) { ++nan; return; }
+        if (!std::isfinite(x)) { ++inf; return; }
+        ++finite; zero += x==0; below_zero += x<0; above_one += x>1;
+        lo=std::min(lo,x); hi=std::max(hi,x); sum+=x; square_sum+=double(x)*x;
+    }
+    double mean() const { return finite ? sum/finite : 0; }
+    double rms() const { return finite ? std::sqrt(square_sum/finite) : 0; }
+    bool valid() const { return nan==0 && inf==0; }
+};
+inline Stats summarize(const float* data, size_t count) {
+    Stats value; for (size_t i=0;i<count;++i) value.add(data[i]); return value;
+}
+template<class Tensor> bool tensor(const char* stage, const Tensor& value) {
+    if (!enabled()) return true;
+    auto stats=summarize(value.data(), size_t(value.numel()));
+    const auto& shape=value.shape();
+    emit("stage=%s count=%lld shape=%lld,%lld,%lld,%lld finite=%zu nan=%zu inf=%zu zero=%zu below0=%zu above1=%zu min=%g max=%g mean=%g rms=%g",
+         stage, (long long)value.numel(), shape.size()>0?(long long)shape[0]:0, shape.size()>1?(long long)shape[1]:0,
+         shape.size()>2?(long long)shape[2]:0, shape.size()>3?(long long)shape[3]:0,
+         stats.finite,stats.nan,stats.inf,stats.zero,stats.below_zero,stats.above_one,stats.lo,stats.hi,stats.mean(),stats.rms());
+    if (shape.size()>=3 && shape[2]==3 && !value.empty()) {
+        size_t plane=size_t(shape[0]*shape[1]);
+        for (unsigned channel=0;channel<3;++channel) {
+            auto c=summarize(value.data()+channel*plane,plane);
+            emit("stage=%s channel=%u finite=%zu nan=%zu inf=%zu min=%g max=%g mean=%g rms=%g",stage,channel,c.finite,c.nan,c.inf,c.lo,c.hi,c.mean(),c.rms());
+        }
+    }
+    if (!stats.valid()) emit("stage=%s REJECT non-finite tensor",stage);
+    return stats.valid();
+}
+}
+#endif
